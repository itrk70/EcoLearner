# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the real ".env" file to GitHub - it must be in .gitignore.

# --- Flask session security ---
FLASK_SECRET_KEY=change-this-to-any-long-random-string

# --- Gmail account used to send Forgot-Password OTP emails ---
# See NOTES_FOR_PRESENTATION.md, "Setting up the Gmail App Password"
# section, for exactly how to get MAIL_PASSWORD.
MAIL_USERNAME=reviewer.00976@gmail.com
MAIL_PASSWORD=paste-the-16-character-app-password-here

# --- Google Sign-In (Phase 5 only - optional, leave blank if not using yet) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
